{
  "name": "parapet",
  "private": true,
  "version": "0.1.0",
  "description": "First-person rooftop parkour in the browser. Procedural everything, zero external assets.",
  "homepage": "https://starknightt.github.io/parapet/",
  "repository": {
    "type": "git",
    "url": "https://github.com/StarKnightt/parapet.git"
  },
  "license": "MIT",
  "author": "Prasenjit Nayak (StarKnightt)",
  "keywords": [
    "threejs",
    "typescript",
    "vite",
    "parkour",
    "first-person",
    "browser-game",
    "webgl",
    "procedural-generation",
    "game"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5310 --strictPort",
    "typecheck": "tsc --noEmit",
    "shoot": "node tools/shoot.mjs"
  },
  "dependencies": {
    "n8ao": "^2.0.1",
    "postprocessing": "^6.39.5",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "playwright": "1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
